# ===================================================
# MEKIKI (目利き) ENVIRONMENT CONFIGURATION
# ===================================================

# 1. Telegram Bot Token (Obtain from @BotFather on Telegram in 60s)
# On Vercel: Set as "Secret" (Private)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. Public Telegram Bot Username (used for "Connect Telegram" button)
# On Vercel: Set as "Config" (Public)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=my_mekiki_trading_bot

# 3. Application URL (used for WebApp Mini App and Telegram Webhook)
# On Vercel: Set as "Config" (Public) - do not include trailing slash
NEXT_PUBLIC_APP_URL=https://mekikixyz.vercel.app

# 4. (Optional) Gemini API Key for deep LLM reasoning fallback
# On Vercel: Set as "Secret" (Private)
GEMINI_API_KEY=
