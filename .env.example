# ===================================================
# MEKIKI (目利き) ENVIRONMENT CONFIGURATION
# ===================================================

# 1. Telegram Bot Token (Obtain from @BotFather on Telegram in 60s)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. Public Telegram Bot Username (used for the "Connect Telegram" button)
# e.g. if your bot is @my_mekiki_bot, put my_mekiki_bot
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=mekiki_agent_bot

# 3. Application URL (used for WebApp Mini App buttons and local forwarding)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. (Optional) Gemini API Key for deep LLM reasoning fallback
GEMINI_API_KEY=
